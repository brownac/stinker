# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=production
PORT=5000

# GitHub Configuration
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# GitHub App Configuration (alternative to PAT)
# Set USE_GITHUB_APP=true to enable GitHub App authentication
USE_GITHUB_APP=false
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=private-key.pem
# Or provide the private key directly (base64 or PEM format):
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...
GITHUB_APP_WEBHOOK_SECRET=your-app-webhook-secret
GITHUB_APP_CLIENT_ID=Iv1.your-client-id
GITHUB_APP_CLIENT_SECRET=your-client-secret

# AI Provider (openai, anthropic, custom)
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Custom AI Endpoint Configuration
CUSTOM_AI_ENDPOINT=https://your-custom-ai-endpoint.com/v1/chat/completions
CUSTOM_AI_API_KEY=your-custom-api-key
CUSTOM_AI_MODEL=your-model-name

# Review Settings
MAX_FILES_TO_ANALYZE=20
MAX_DIFF_SIZE=10000
PATTERN_ANALYSIS_DEPTH=100

# Database - Turso (cloud) or SQLite (local fallback)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
DATABASE_PATH=patterns.db
